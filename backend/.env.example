# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ai_support_agent
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Vector Store (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embeddings Configuration
DISABLE_SSL_VERIFY=true
EMBEDDING_FALLBACK_MODE=auto
EMBEDDING_CACHE_DIR=./data/models

# AI/LLM
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
DEBUG=True
LOG_LEVEL=INFO

# Collector
GIT_REPO_PATH=/path/to/target/repo
LOG_FILES_PATH=/path/to/logs

# Jira Integration
JIRA_URL=https://votre-domaine.atlassian.net
JIRA_EMAIL=votre.email@example.com
JIRA_API_TOKEN=votre_token_api_jira

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ===========================================================
#  LIVE DIAGNOSTICS — Serveurs BRASIL
#
#  Convention nommage :
#    PROD  →  op49m{type}{instance}  ex: op49mdb11, op49mwb11
#    DEV   →  dv49m{type}{instance}  ex: dv49mdb31, dv49mwb31
#
#  3 types : DB (PostgreSQL) | DE (Data Extractor) | WA (Tomcat/IHM)
# ===========================================================

SSH_ENABLED=false
SSH_BRASIL_ENV=prod          # prod | dev | test
SSH_CONNECT_TIMEOUT_S=15
SSH_COMMAND_TIMEOUT_S=30
SSH_AUTO_ADD_HOST_KEY=false

# ── Serveur DB (PostgreSQL + psql) ───────────────────────
# prod: op49mdb11  |  dev: dv49mdb31
SSH_BRASIL_HOST=op49mdb11
SSH_BRASIL_PORT=22
SSH_BRASIL_USER=op49mbdd
SSH_BRASIL_PASSWORD=votre_mot_de_passe
# SSH_BRASIL_PRIVATE_KEY=C:/Users/vous/.ssh/id_rsa

# ── Serveur DE (Data Extractor) ──────────────────────────
# prod: op49mde11  |  dev: dv49mde31
SSH_DE_HOST=op49mde11
SSH_DE_PORT=22
SSH_DE_USER=op49mbdd
SSH_DE_PASSWORD=votre_mot_de_passe

# ── Serveur WA (Applicatif Tomcat IHM+WS) ────────────────
# prod: op49mwb11  |  dev: dv49mwb31
SSH_WA_HOST=op49mwb11
SSH_WA_PORT=22
SSH_WA_USER=op49mbdd
SSH_WA_PASSWORD=votre_mot_de_passe

# ── Brasil DB — accès lecture seule (diagnostics SQL) ─────
BRASIL_DB_HOST=localhost
BRASIL_DB_PORT=5432
BRASIL_DB_NAME=brasil
BRASIL_DB_USER=brasil_readonly
BRASIL_DB_PASSWORD=votre_mot_de_passe

# ── Code Intelligence (Phase 2, désactivé) ────────────────
CODE_INTELLIGENCE_ENABLED=false
# BRASIL_SOURCE_ROOT=D:/brasil/sources


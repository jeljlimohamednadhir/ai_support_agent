# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ai_support_agent
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Vector Store (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embeddings Configuration
DISABLE_SSL_VERIFY=true
EMBEDDING_FALLBACK_MODE=auto
EMBEDDING_CACHE_DIR=./data/models

# AI/LLM
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
DEBUG=True
LOG_LEVEL=INFO

# Collector
GIT_REPO_PATH=/path/to/target/repo
LOG_FILES_PATH=/path/to/logs

# Jira Integration
JIRA_URL=https://votre-domaine.atlassian.net
JIRA_EMAIL=votre.email@example.com
JIRA_API_TOKEN=votre_token_api_jira

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
